root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}]
indent_size = 2
indent_style = space

[{*.json,*.yaml,*.yml}]
indent_size = 2

[*.md]
max_line_length = 0
trim_trailing_whitespace = false