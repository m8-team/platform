{
  "name": "m8-platform-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "scripts": {
    "docs:build": "node scripts/prepare-docs.mjs && yfm build -c ./.yfm -i build/docs-input -o build/docs",
